//////////////////////////////////////////////////////
// AI QUESTION BANK SaaS - CANONICAL DATABASE DESIGN
// Version: 0.15.3
// Target: Laravel 13 / MySQL 8+
//////////////////////////////////////////////////////

Enum user_status {
  active
  suspended
  inactive
}

Enum generation_reset_strategy {
  lifetime
  monthly
}

Enum plan_status {
  active
  inactive
}

Enum subscription_status {
  active
  expired
  cancelled
}

Enum plan_offer_status {
  active
  inactive
}

Enum upgrade_request_status {
  pending
  approved
  rejected
  cancelled
}

Enum source_type {
  upload
  text
}

Enum extraction_status {
  pending
  processing
  completed
  failed
  not_required
}

Enum material_status {
  draft
  ready
  archived
}

Enum material_profile_status {
  queued
  processing
  ready
  failed
}

Enum material_profile_step_purpose {
  map
  reduce
}

Enum material_profile_step_status {
  queued
  processing
  ready
  failed
}

Enum material_profile_attempt_status {
  started
  succeeded
  failed
}

Enum material_profile_element_origin {
  extracted
  suggested
}

Enum material_profile_element_kind {
  topic
  objective
  indicator
  other
}

Enum prompt_status {
  draft
  active
  inactive
}

Enum assessment_type {
  formative
  summative
  diagnostic
}

Enum difficulty_level {
  easy
  medium
  hard
  hots
}

Enum question_type {
  multiple_choice
  true_false
  essay
}

Enum generation_status {
  queued
  processing
  completed
  failed
  cancelled
}

Enum question_set_status {
  draft
  generating
  review
  published
  archived
}

Enum review_status {
  not_submitted
  pending
  approved
  rejected
}

Enum visibility {
  private
  public
}

Enum usage_status {
  reserved
  charged
  released
}

Enum campaign_status {
  draft
  scheduled
  processing
  completed
  failed
  cancelled
}

Enum delivery_status {
  queued
  sent
  delivered
  read
  failed
}

//////////////////////////////////////////////////////
// USER MANAGEMENT
//////////////////////////////////////////////////////

Table users {
  id bigint [pk, increment]
  google_id varchar(255) [not null, unique]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  avatar_url varchar(2048)
  phone_number varchar(32)
  phone_verified_at timestamp
  marketing_consent boolean [not null, default: false]
  status user_status [not null, default: 'active']
  last_login_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    status
    phone_number
  }

  Note: 'Google OAuth only. Tidak menyimpan password lokal.'
}

Table roles {
  id bigint [pk, increment]
  role_name varchar(32) [not null, unique]
  description text
  created_at timestamp
  updated_at timestamp

  Note: 'Seed minimum: USER dan ADMIN.'
}

Table role_user {
  user_id bigint [not null]
  role_id bigint [not null]
  created_at timestamp

  indexes {
    (user_id, role_id) [pk]
    role_id
  }
}

//////////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////////

Table plans {
  plan_id bigint [pk, increment]
  code varchar(32) [not null, unique, note: 'Machine key: free, pro']
  name varchar(100) [not null]
  storage_limit_bytes bigint [not null, note: 'Free 52428800; Pro 524288000']
  generation_limit int [not null, note: 'Free 2 lifetime; Pro 100 per monthly window']
  generation_reset_strategy generation_reset_strategy [not null]
  status plan_status [not null, default: 'active']
  created_at timestamp
  updated_at timestamp

  Note: 'Entitlement catalog only. One Pro plan. Price and commercial duration belong to plan_offers, not Plan entitlement columns. Free is fallback entitlement, not a subscription row.'
}

Table subscriptions {
  subscription_id bigint [pk, increment]
  user_id bigint [not null]
  plan_id bigint [not null]
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  status subscription_status [not null]
  cancelled_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, status)
  }

  Note: 'Finite Pro entitlement windows only. No Free subscription rows. Effectiveness is [starts_at, ends_at). Sequential non-overlapping active rows are allowed for renewal. Application-layer resolver validates the current/future active queue as Pro and fails closed on overlapping effective windows. Overlap is not a unique status constraint.'
}

Table plan_offers {
  offer_id bigint [pk, increment]
  plan_id bigint [not null]
  code varchar(32) [not null, unique, note: 'Machine key: pro_1m, pro_3m']
  name varchar(100) [not null]
  duration_months tinyint [not null, note: 'Calendar months; no-overflow arithmetic']
  price_amount int [not null, note: 'Integer Rupiah']
  currency char(3) [not null, note: 'IDR']
  status plan_offer_status [not null, default: 'active']
  sort_order int [not null, default: 0]
  created_at timestamp
  updated_at timestamp

  indexes {
    (plan_id, status, sort_order)
  }

  Note: 'Commercial offers for the single canonical Pro Plan. Not extra Plans. No Free offers. Inactive offers are hidden from new purchases; existing pending requests keep their snapshots.'
}

Table subscription_upgrade_requests {
  upgrade_request_id bigint [pk, increment]
  user_id bigint [not null]
  offer_id bigint [not null]
  plan_id bigint [not null]
  reference_code varchar(32) [not null, unique]
  status upgrade_request_status [not null]
  offer_code varchar(32) [not null]
  offer_name varchar(100) [not null]
  duration_months tinyint [not null]
  price_amount int [not null]
  currency char(3) [not null]
  requested_at timestamp [not null]
  reviewed_at timestamp
  reviewed_by bigint
  rejection_reason text
  approved_subscription_id bigint [unique, note: 'Nullable until approval; one Subscription per approved request']
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, status)
    (status, requested_at)
  }

  Note: 'Manual payment audit. Not Subscription status. At most one pending request per user is enforced in application under a user-row lock. Unique (user_id, status) is not used. Approval appends one Pro window using snapshotted duration.'
}

//////////////////////////////////////////////////////
// MATERIAL MANAGEMENT
//////////////////////////////////////////////////////

Table materials {
  material_id bigint [pk, increment]
  user_id bigint [not null]
  title varchar(255) [not null]
  source_type source_type [not null]
  file_name varchar(255)
  file_path varchar(2048)
  file_size bigint
  file_hash char(64)
  mime_type varchar(127)
  content longtext
  extraction_status extraction_status [not null, default: 'pending']
  status material_status [not null, default: 'draft']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (user_id, status)
    (user_id, extraction_status)
    (user_id, file_hash) [unique]
  }

  Note: 'New Material creation is upload-only (PDF/DOCX/TXT, max 10 MB per file; MVP safety, not replaced by Plan quota). Account storage quota is Plan.storage_limit_bytes, enforced on file upload. Over-quota users cannot create a new Material. Legacy source_type=text rows remain readable/editable; HTTP text creation is retired. Text uses not_required. No file replacement. All non-deleted uploads including archived/failed count as storage usage. Owner lifecycle: draft/ready to archived and archived to ready.'
}

Table material_topics {
  topic_id bigint [pk, increment]
  material_id bigint [not null]
  topic_name varchar(255) [not null]
  focus_area varchar(255)
  chapter varchar(255) [not null, default: '']
  sub_chapter varchar(255) [not null, default: '']
  sort_order int [not null, default: 0, note: 'Urutan topik untuk pemrosesan AI/konten']
  page_start int
  page_end int
  created_at timestamp
  updated_at timestamp

  indexes {
    (material_id, sort_order)
    (material_id, chapter, sub_chapter, topic_name) [unique]
  }
}

Table material_profile_versions {
  profile_version_id bigint [pk, increment]
  material_id bigint [not null]
  user_id bigint [not null]
  version int [not null]
  status material_profile_status [not null]
  workflow_token char(36) [not null]
  queued_at timestamp [not null]
  started_at timestamp
  completed_at timestamp
  failed_at timestamp
  error_code varchar(64)
  error_message varchar(255)
  material_content_hash char(64) [not null]
  material_file_hash char(64)
  extractor_implementation varchar(100) [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (material_id, version) [unique, name: 'mat_prof_ver_material_version_uq']
    (material_id, status) [name: 'mat_prof_ver_material_status_idx']
    (user_id, created_at) [name: 'mat_prof_ver_user_created_idx']
  }

  Note: 'Phase 5.7B1 foundation. One workflow_token per version. No Gemini, no production HTTP, no production job dispatch. At most one queued or processing version per Material is enforced in application under User then Material locks.'
}

Table material_profile_chunks {
  profile_chunk_id bigint [pk, increment]
  profile_version_id bigint [not null]
  chunk_index int [not null]
  char_start int [not null]
  char_end int [not null]
  overlap_before_start int
  overlap_before_end int
  core_text_hash char(64) [not null]
  required boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp

  indexes {
    (profile_version_id, chunk_index) [unique, name: 'mat_prof_chunk_version_index_uq']
  }

  Note: 'UTF-8 code-point offsets. char_start inclusive, char_end exclusive. Overlap is extra context outside the core. No step status, token, or lease columns.'
}

Table material_profile_steps {
  profile_step_id bigint [pk, increment]
  profile_version_id bigint [not null]
  purpose material_profile_step_purpose [not null]
  step_index int [not null]
  profile_chunk_id bigint
  status material_profile_step_status [not null]
  workflow_token char(36) [not null]
  step_execution_token char(36)
  step_queued_at timestamp
  claimed_at timestamp
  heartbeat_at timestamp
  lease_expires_at timestamp
  error_code varchar(64)
  error_message varchar(255)
  created_at timestamp
  updated_at timestamp

  indexes {
    (profile_version_id, purpose, step_index) [unique, name: 'mat_prof_step_ver_purpose_idx_uq']
    (profile_chunk_id) [unique, name: 'mat_prof_step_chunk_id_uq']
    (profile_version_id, status) [name: 'mat_prof_step_version_status_idx']
  }

  Note: 'Lifecycle source of truth. Map requires profile_chunk_id. Reduce uses purpose=reduce, step_index=0, profile_chunk_id null. Unique nullable profile_chunk_id allows one map step per chunk and multiple reduce nulls.'
}

Table material_profile_elements {
  profile_element_id bigint [pk, increment]
  profile_version_id bigint [not null]
  source_chunk_id bigint
  kind material_profile_element_kind [not null]
  text text [not null]
  origin material_profile_element_origin [not null]
  evidence_excerpt text
  evidence_locator varchar(255)
  char_start int
  char_end int
  sort_order int [not null, default: 0]
  created_at timestamp
  updated_at timestamp

  indexes {
    (profile_version_id, sort_order) [name: 'mat_prof_elem_version_sort_idx']
  }

  Note: 'Extracted elements require source_chunk_id on the same Profile Version. Suggested elements may omit chunk context.'
}

Table material_profile_attempts {
  profile_attempt_id bigint [pk, increment]
  profile_version_id bigint [not null]
  profile_step_id bigint [not null]
  attempt_number int [not null]
  provider varchar(32) [not null]
  model varchar(100) [not null]
  prompt_version varchar(32) [not null]
  purpose material_profile_step_purpose [not null]
  status material_profile_attempt_status [not null]
  input_tokens int
  output_tokens int
  total_tokens int
  latency_ms int
  error_code varchar(64)
  started_at timestamp [not null]
  finished_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (profile_step_id, attempt_number) [unique, name: 'mat_prof_attempt_step_number_uq']
    (profile_version_id) [name: 'mat_prof_attempt_version_idx']
  }

  Note: 'No raw prompt or raw provider response. Attempt error codes are provider_timeout, provider_http, schema_invalid, and validation_failed.'
}

//////////////////////////////////////////////////////
// AI ENGINE
//////////////////////////////////////////////////////

Table prompt_versions {
  prompt_version_id bigint [pk, increment]
  version_number varchar(32) [not null, unique]
  prompt_name varchar(255) [not null]
  base_prompt text [not null]
  material_rule text [not null]
  assessment_rule text [not null]
  difficulty_rule text [not null]
  question_rule text [not null]
  answer_rule text [not null]
  explanation_rule text
  quality_rule text
  output_schema json [not null]
  status prompt_status [not null, default: 'draft']
  created_by bigint [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    status
    created_by
  }

  Note: 'Planned catalog table. Not implemented. Phase 4.3+4.4 stores prompt identity as ai_generation_attempts.prompt_version from McqPromptBuilder.'
}

Table ai_generations {
  generation_id bigint [pk, increment]
  user_id bigint [not null]
  material_id bigint [not null]
  assessment_type assessment_type [not null]
  difficulty_level difficulty_level [not null]
  question_type question_type [not null]
  question_count int [not null]
  output_language varchar(8) [note: 'id or en. Nullable for pre-4.3 legacy rows. New Start requires a value.']
  generation_status generation_status [not null, default: 'queued']
  execution_token varchar(36)
  error_message text
  error_code varchar(64)
  attempt_number int [not null, default: 0, note: 'Count of provider HTTP calls started. 0 while queued. Never 4.']
  result_json json [note: 'Validated MCQ array. Partial after each attempt. Completed length equals question_count.']
  provider_name varchar(32)
  model_name varchar(100)
  input_tokens int
  output_tokens int
  parent_generation_id bigint
  queued_at timestamp
  started_at timestamp
  completed_at timestamp [note: 'Success only']
  failed_at timestamp [note: 'Terminal failure']
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, created_at) [name: 'ai_gen_user_created_idx']
    material_id [name: 'ai_gen_material_id_idx']
    generation_status [name: 'ai_gen_status_idx']
    parent_generation_id [name: 'ai_gen_parent_id_idx']
  }

  Note: 'Phase 4.3–4.6. No topic_id, prompt_version_id, prompt_version, raw_response, or parsed_output. question_count max is configurable (default 10). parent_generation_id is manual retry lineage written in the Start transaction. execution_token is DB-authoritative Job ownership. No reservation_expires_at.'
}

Table ai_usage_logs {
  usage_id bigint [pk, increment]
  user_id bigint [not null]
  plan_id bigint [not null]
  subscription_id bigint [note: 'Null iff Free lifetime reservation; required for Pro window reservation']
  generation_id bigint [not null, unique]
  status usage_status [not null, default: 'reserved']
  window_start timestamp [note: 'Pro window start captured at reservation; null iff Free']
  window_end timestamp [note: 'Pro exclusive window end captured at reservation; null iff Free']
  reserved_at timestamp [not null]
  finalized_at timestamp [note: 'Set when reserved becomes charged or released']
  created_at timestamp
  updated_at timestamp

  indexes {
    generation_id [unique, name: 'ai_usage_generation_unique']
    (user_id, status) [name: 'ai_usage_user_status_idx']
    (user_id, plan_id, status) [name: 'ai_usage_free_lifetime_idx']
    (user_id, subscription_id, window_start, status) [name: 'ai_usage_pro_window_idx']
  }

  Note: 'Stateful one-row-per-Generation ledger (UNIQUE generation_id). One Generation request = one credit. reserved occupies capacity; charged permanently consumes one credit; released occupies/consumes zero. Counting is by row/state, not credit_used. Free: plan_id=Free AND subscription_id IS NULL (lifetime; survives Free→Pro→Free). Pro: subscription_id + exact persisted window_start/window_end from Start. Live Plan.generation_limit is allowance. Consume/Release finalize the stored reservation only and must not re-resolve current entitlement. No usage_action, credit_used, or reservation_expires_at. Stale reserved queued/processing rows are recovered to failed+released (stale_recovery) without reservation_expires_at.'
}

Table ai_generation_attempts {
  attempt_id bigint [pk, increment]
  generation_id bigint [not null]
  attempt_number int [not null]
  provider varchar(32) [not null]
  model varchar(100) [not null]
  purpose varchar(16) [not null, note: 'initial or repair']
  prompt_version varchar(32) [not null, note: 'Builder version at HTTP start, not Start-time snapshot']
  requested_count int [not null]
  accepted_count int [not null, default: 0]
  status varchar(16) [not null, note: 'started, succeeded, or failed']
  input_tokens int
  output_tokens int
  total_tokens int
  latency_ms int
  finish_reason varchar(32)
  safe_error_code varchar(64)
  started_at timestamp [not null]
  finished_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (generation_id, attempt_number) [unique, name: 'ai_gen_attempt_unique']
    generation_id [name: 'ai_gen_attempt_gen_idx']
  }

  Note: 'One row per provider HTTP call. Inserted before HTTP. No raw prompt or raw response.'
}

//////////////////////////////////////////////////////
// QUESTION BANK
//////////////////////////////////////////////////////

Table question_sets {
  question_set_id bigint [pk, increment]
  user_id bigint [not null]
  generation_id bigint [unique]
  title varchar(255) [not null]
  description text
  subject varchar(255)
  grade_level varchar(100)
  total_question int [not null, default: 0]
  visibility visibility [not null, default: 'private']
  status question_set_status [not null, default: 'draft']
  review_status review_status [not null, default: 'not_submitted']
  reviewed_by bigint
  reviewed_at timestamp
  review_notes text
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (user_id, status)
    (user_id, review_status)
    reviewed_by
  }

  Note: 'Phase 5 COMPLETE (MCQ-only). Phase 4 generation jobs do not create Question Sets. Import creates a draft snapshot from one completed MCQ Generation. generation_id is UNIQUE and nullable (future manual sets). Edit updates draft MCQ content only. Publish writes status=published only. Locked product lifecycle is draft to published. generating/review/archived are not active paths. True/false and essay Question Bank are later.'
}

Table questions {
  question_id bigint [pk, increment]
  question_set_id bigint [not null]
  question_number int [not null]
  question_text text [not null]
  question_type question_type [not null]
  difficulty_level difficulty_level [not null]
  correct_answer text
  explanation text
  rubric text
  points decimal(6,2) [not null, default: 1]
  created_at timestamp
  updated_at timestamp

  indexes {
    question_set_id
    (question_set_id, question_number) [unique]
  }

  Note: 'Essay memakai correct_answer/rubric tanpa options. MCQ dan true-false memakai question_options.'
}

Table question_options {
  option_id bigint [pk, increment]
  question_id bigint [not null]
  option_label varchar(8) [not null]
  option_text text [not null]
  is_correct boolean [not null, default: false]
  sort_order int [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    question_id
    (question_id, option_label) [unique]
    (question_id, sort_order) [unique]
  }
}

//////////////////////////////////////////////////////
// WHATSAPP CRM
//////////////////////////////////////////////////////

Table whatsapp_contacts {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  phone_number varchar(32) [not null, unique]
  country_code varchar(8) [not null, default: '+62']
  provider_wa_id varchar(255)
  is_verified boolean [not null, default: false]
  marketing_consent boolean [not null, default: false]
  opt_out_at timestamp
  last_message_sent_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    provider_wa_id
    marketing_consent
  }

  Note: 'Nomor disimpan dalam format E.164 dan menjadi sumber utama kontak WhatsApp.'
}

Table broadcast_campaigns {
  campaign_id bigint [pk, increment]
  admin_id bigint [not null]
  campaign_name varchar(255) [not null]
  message_template text [not null]
  target_segment json [not null]
  total_target int [not null, default: 0]
  success_count int [not null, default: 0]
  failed_count int [not null, default: 0]
  scheduled_at timestamp
  sent_at timestamp
  status campaign_status [not null, default: 'draft']
  created_at timestamp
  updated_at timestamp

  indexes {
    admin_id
    (status, scheduled_at)
  }
}

Table broadcast_logs {
  broadcast_log_id bigint [pk, increment]
  campaign_id bigint [not null]
  user_id bigint [not null]
  phone_number varchar(32) [not null]
  message_content text [not null]
  provider_message_id varchar(255)
  delivery_status delivery_status [not null, default: 'queued']
  provider_response text
  sent_at timestamp
  delivered_at timestamp
  read_at timestamp
  failed_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (campaign_id, user_id) [unique]
    (campaign_id, delivery_status)
    user_id
    provider_message_id
  }
}

//////////////////////////////////////////////////////
// RELATIONSHIPS
//////////////////////////////////////////////////////

Ref: users.id < role_user.user_id [delete: cascade]
Ref: roles.id < role_user.role_id [delete: cascade]

Ref: users.id < subscriptions.user_id [delete: restrict]
Ref: plans.plan_id < subscriptions.plan_id [delete: restrict]
Ref: plans.plan_id < plan_offers.plan_id [delete: restrict]
Ref: users.id < subscription_upgrade_requests.user_id [delete: restrict]
Ref: plan_offers.offer_id < subscription_upgrade_requests.offer_id [delete: restrict]
Ref: plans.plan_id < subscription_upgrade_requests.plan_id [delete: restrict]
Ref: users.id < subscription_upgrade_requests.reviewed_by [delete: restrict]
Ref: subscriptions.subscription_id < subscription_upgrade_requests.approved_subscription_id [delete: restrict]

Ref: users.id < materials.user_id
Ref: materials.material_id < material_topics.material_id [delete: cascade]
Ref: materials.material_id < material_profile_versions.material_id [delete: restrict]
Ref: users.id < material_profile_versions.user_id [delete: restrict]
Ref: material_profile_versions.profile_version_id < material_profile_chunks.profile_version_id [delete: restrict]
Ref: material_profile_versions.profile_version_id < material_profile_steps.profile_version_id [delete: restrict]
Ref: material_profile_chunks.profile_chunk_id < material_profile_steps.profile_chunk_id [delete: restrict]
Ref: material_profile_versions.profile_version_id < material_profile_elements.profile_version_id [delete: restrict]
Ref: material_profile_chunks.profile_chunk_id < material_profile_elements.source_chunk_id [delete: restrict]
Ref: material_profile_versions.profile_version_id < material_profile_attempts.profile_version_id [delete: restrict]
Ref: material_profile_steps.profile_step_id < material_profile_attempts.profile_step_id [delete: restrict]

Ref: users.id < prompt_versions.created_by
Ref: users.id < ai_generations.user_id [delete: restrict]
Ref: materials.material_id < ai_generations.material_id [delete: restrict]
Ref: ai_generations.generation_id < ai_generations.parent_generation_id [delete: restrict]

Ref: users.id < ai_usage_logs.user_id [delete: restrict]
Ref: plans.plan_id < ai_usage_logs.plan_id [delete: restrict]
Ref: subscriptions.subscription_id < ai_usage_logs.subscription_id [delete: restrict]
Ref: ai_generations.generation_id < ai_usage_logs.generation_id [delete: restrict]
Ref: ai_generations.generation_id < ai_generation_attempts.generation_id [delete: restrict]

Ref: users.id < question_sets.user_id
Ref: ai_generations.generation_id - question_sets.generation_id
Ref: users.id < question_sets.reviewed_by
Ref: question_sets.question_set_id < questions.question_set_id [delete: cascade]
Ref: questions.question_id < question_options.question_id [delete: cascade]

Ref: users.id - whatsapp_contacts.user_id [delete: cascade]
Ref: users.id < broadcast_campaigns.admin_id
Ref: broadcast_campaigns.campaign_id < broadcast_logs.campaign_id [delete: cascade]
Ref: users.id < broadcast_logs.user_id
