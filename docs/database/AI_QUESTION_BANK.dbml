//////////////////////////////////////////////////////
// AI QUESTION BANK SaaS - CANONICAL DATABASE DESIGN
// Version: 0.9.0
// Target: Laravel 13 / MySQL 8+
//////////////////////////////////////////////////////

Enum user_status {
  active
  suspended
  inactive
}

Enum generation_reset_strategy {
  lifetime
  monthly
}

Enum plan_status {
  active
  inactive
}

Enum subscription_status {
  active
  expired
  cancelled
}

Enum plan_offer_status {
  active
  inactive
}

Enum upgrade_request_status {
  pending
  approved
  rejected
  cancelled
}

Enum source_type {
  upload
  text
}

Enum extraction_status {
  pending
  processing
  completed
  failed
  not_required
}

Enum material_status {
  draft
  ready
  archived
}

Enum prompt_status {
  draft
  active
  inactive
}

Enum assessment_type {
  formative
  summative
  diagnostic
}

Enum difficulty_level {
  easy
  medium
  hard
  hots
}

Enum question_type {
  multiple_choice
  true_false
  essay
}

Enum generation_status {
  queued
  processing
  completed
  failed
  cancelled
}

Enum question_set_status {
  draft
  generating
  review
  published
  archived
}

Enum review_status {
  not_submitted
  pending
  approved
  rejected
}

Enum visibility {
  private
  public
}

Enum usage_action {
  generate
  retry
}

Enum usage_status {
  reserved
  charged
  released
}

Enum campaign_status {
  draft
  scheduled
  processing
  completed
  failed
  cancelled
}

Enum delivery_status {
  queued
  sent
  delivered
  read
  failed
}

//////////////////////////////////////////////////////
// USER MANAGEMENT
//////////////////////////////////////////////////////

Table users {
  id bigint [pk, increment]
  google_id varchar(255) [not null, unique]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  avatar_url varchar(2048)
  phone_number varchar(32)
  phone_verified_at timestamp
  marketing_consent boolean [not null, default: false]
  status user_status [not null, default: 'active']
  last_login_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    status
    phone_number
  }

  Note: 'Google OAuth only. Tidak menyimpan password lokal.'
}

Table roles {
  id bigint [pk, increment]
  role_name varchar(32) [not null, unique]
  description text
  created_at timestamp
  updated_at timestamp

  Note: 'Seed minimum: USER dan ADMIN.'
}

Table role_user {
  user_id bigint [not null]
  role_id bigint [not null]
  created_at timestamp

  indexes {
    (user_id, role_id) [pk]
    role_id
  }
}

//////////////////////////////////////////////////////
// SUBSCRIPTION
//////////////////////////////////////////////////////

Table plans {
  plan_id bigint [pk, increment]
  code varchar(32) [not null, unique, note: 'Machine key: free, pro']
  name varchar(100) [not null]
  storage_limit_bytes bigint [not null, note: 'Free 52428800; Pro 524288000']
  generation_limit int [not null, note: 'Free 2 lifetime; Pro 100 per monthly window']
  generation_reset_strategy generation_reset_strategy [not null]
  status plan_status [not null, default: 'active']
  created_at timestamp
  updated_at timestamp

  Note: 'Entitlement catalog only. One Pro plan. Price and commercial duration belong to plan_offers, not Plan entitlement columns. Free is fallback entitlement, not a subscription row.'
}

Table subscriptions {
  subscription_id bigint [pk, increment]
  user_id bigint [not null]
  plan_id bigint [not null]
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  status subscription_status [not null]
  cancelled_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, status)
  }

  Note: 'Finite Pro entitlement windows only. No Free subscription rows. Effectiveness is [starts_at, ends_at). Sequential non-overlapping active rows are allowed for renewal. Application-layer resolver validates the current/future active queue as Pro and fails closed on overlapping effective windows. Overlap is not a unique status constraint.'
}

Table plan_offers {
  offer_id bigint [pk, increment]
  plan_id bigint [not null]
  code varchar(32) [not null, unique, note: 'Machine key: pro_1m, pro_3m']
  name varchar(100) [not null]
  duration_months tinyint [not null, note: 'Calendar months; no-overflow arithmetic']
  price_amount int [not null, note: 'Integer Rupiah']
  currency char(3) [not null, note: 'IDR']
  status plan_offer_status [not null, default: 'active']
  sort_order int [not null, default: 0]
  created_at timestamp
  updated_at timestamp

  indexes {
    (plan_id, status, sort_order)
  }

  Note: 'Commercial offers for the single canonical Pro Plan. Not extra Plans. No Free offers. Inactive offers are hidden from new purchases; existing pending requests keep their snapshots.'
}

Table subscription_upgrade_requests {
  upgrade_request_id bigint [pk, increment]
  user_id bigint [not null]
  offer_id bigint [not null]
  plan_id bigint [not null]
  reference_code varchar(32) [not null, unique]
  status upgrade_request_status [not null]
  offer_code varchar(32) [not null]
  offer_name varchar(100) [not null]
  duration_months tinyint [not null]
  price_amount int [not null]
  currency char(3) [not null]
  requested_at timestamp [not null]
  reviewed_at timestamp
  reviewed_by bigint
  rejection_reason text
  approved_subscription_id bigint [unique, note: 'Nullable until approval; one Subscription per approved request']
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, status)
    (status, requested_at)
  }

  Note: 'Manual payment audit. Not Subscription status. At most one pending request per user is enforced in application under a user-row lock. Unique (user_id, status) is not used. Approval appends one Pro window using snapshotted duration.'
}

//////////////////////////////////////////////////////
// MATERIAL MANAGEMENT
//////////////////////////////////////////////////////

Table materials {
  material_id bigint [pk, increment]
  user_id bigint [not null]
  title varchar(255) [not null]
  source_type source_type [not null]
  file_name varchar(255)
  file_path varchar(2048)
  file_size bigint
  file_hash char(64)
  mime_type varchar(127)
  content longtext
  extraction_status extraction_status [not null, default: 'pending']
  status material_status [not null, default: 'draft']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (user_id, status)
    (user_id, extraction_status)
    (user_id, file_hash) [unique]
  }

  Note: 'Upload PDF/DOCX/TXT maksimal 10 MB per file (MVP safety; not replaced by Plan quota). Account storage quota is Plan.storage_limit_bytes, enforced on file upload. Text requires content and uses not_required. All non-deleted uploads including archived/failed count as storage usage. Owner lifecycle: draft/ready to archived and archived to ready.'
}

Table material_topics {
  topic_id bigint [pk, increment]
  material_id bigint [not null]
  topic_name varchar(255) [not null]
  focus_area varchar(255)
  chapter varchar(255) [not null, default: '']
  sub_chapter varchar(255) [not null, default: '']
  sort_order int [not null, default: 0, note: 'Urutan topik untuk pemrosesan AI/konten']
  page_start int
  page_end int
  created_at timestamp
  updated_at timestamp

  indexes {
    (material_id, sort_order)
    (material_id, chapter, sub_chapter, topic_name) [unique]
  }
}

//////////////////////////////////////////////////////
// AI ENGINE
//////////////////////////////////////////////////////

Table prompt_versions {
  prompt_version_id bigint [pk, increment]
  version_number varchar(32) [not null, unique]
  prompt_name varchar(255) [not null]
  base_prompt text [not null]
  material_rule text [not null]
  assessment_rule text [not null]
  difficulty_rule text [not null]
  question_rule text [not null]
  answer_rule text [not null]
  explanation_rule text
  quality_rule text
  output_schema json [not null]
  status prompt_status [not null, default: 'draft']
  created_by bigint [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    status
    created_by
  }

  Note: 'Aplikasi memastikan hanya satu prompt version aktif.'
}

Table ai_generations {
  generation_id bigint [pk, increment]
  user_id bigint [not null]
  material_id bigint [not null]
  topic_id bigint
  prompt_version_id bigint [not null]
  assessment_type assessment_type [not null]
  difficulty_level difficulty_level [not null]
  question_type question_type [not null]
  question_count int [not null]
  provider_name varchar(64) [not null, default: 'google_gemini']
  model_name varchar(100) [not null]
  temperature decimal(3,2)
  input_token int [not null, default: 0]
  output_token int [not null, default: 0]
  estimated_cost decimal(14,6) [not null, default: 0]
  raw_response text
  parsed_output json
  generation_status generation_status [not null, default: 'queued']
  error_message text
  attempt_number int [not null, default: 1]
  parent_generation_id bigint
  queued_at timestamp
  started_at timestamp
  completed_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, created_at)
    material_id
    topic_id
    generation_status
    parent_generation_id
  }
}

Table ai_usage_logs {
  usage_id bigint [pk, increment]
  user_id bigint [not null]
  plan_id bigint [not null]
  subscription_id bigint [note: 'Nullable for Free fallback usage; required for Pro window usage']
  generation_id bigint [not null]
  action_type usage_action [not null]
  credit_used int [not null, default: 0]
  token_used int [not null, default: 0]
  estimated_cost decimal(14,6) [not null, default: 0]
  status usage_status [not null]
  reservation_expires_at timestamp
  created_at timestamp

  indexes {
    (user_id, created_at)
    (plan_id, created_at)
    (subscription_id, created_at)
    generation_id
  }

  Note: 'Future generation quota ledger (Phase 4). Not implemented. Phase 3.5 defines generation limits/windows only; it does not consume credits. Free usage: plan_id = Free, subscription_id null. Pro usage: plan_id = Pro, subscription_id = effective Pro window. Charged Free rows count toward lifetime entitlement; charged Pro rows count toward the subscription window.'
}

//////////////////////////////////////////////////////
// QUESTION BANK
//////////////////////////////////////////////////////

Table question_sets {
  question_set_id bigint [pk, increment]
  user_id bigint [not null]
  generation_id bigint [unique]
  title varchar(255) [not null]
  description text
  subject varchar(255)
  grade_level varchar(100)
  total_question int [not null, default: 0]
  visibility visibility [not null, default: 'private']
  status question_set_status [not null, default: 'draft']
  review_status review_status [not null, default: 'not_submitted']
  reviewed_by bigint
  reviewed_at timestamp
  review_notes text
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (user_id, status)
    (user_id, review_status)
    reviewed_by
  }

  Note: 'Dibuat draft sebelum generation. generation_id nullable untuk set manual atau sebelum job diantrekan.'
}

Table questions {
  question_id bigint [pk, increment]
  question_set_id bigint [not null]
  question_number int [not null]
  question_text text [not null]
  question_type question_type [not null]
  difficulty_level difficulty_level [not null]
  correct_answer text
  explanation text
  rubric text
  points decimal(6,2) [not null, default: 1]
  created_at timestamp
  updated_at timestamp

  indexes {
    question_set_id
    (question_set_id, question_number) [unique]
  }

  Note: 'Essay memakai correct_answer/rubric tanpa options. MCQ dan true-false memakai question_options.'
}

Table question_options {
  option_id bigint [pk, increment]
  question_id bigint [not null]
  option_label varchar(8) [not null]
  option_text text [not null]
  is_correct boolean [not null, default: false]
  sort_order int [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    question_id
    (question_id, option_label) [unique]
    (question_id, sort_order) [unique]
  }
}

//////////////////////////////////////////////////////
// WHATSAPP CRM
//////////////////////////////////////////////////////

Table whatsapp_contacts {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  phone_number varchar(32) [not null, unique]
  country_code varchar(8) [not null, default: '+62']
  provider_wa_id varchar(255)
  is_verified boolean [not null, default: false]
  marketing_consent boolean [not null, default: false]
  opt_out_at timestamp
  last_message_sent_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    provider_wa_id
    marketing_consent
  }

  Note: 'Nomor disimpan dalam format E.164 dan menjadi sumber utama kontak WhatsApp.'
}

Table broadcast_campaigns {
  campaign_id bigint [pk, increment]
  admin_id bigint [not null]
  campaign_name varchar(255) [not null]
  message_template text [not null]
  target_segment json [not null]
  total_target int [not null, default: 0]
  success_count int [not null, default: 0]
  failed_count int [not null, default: 0]
  scheduled_at timestamp
  sent_at timestamp
  status campaign_status [not null, default: 'draft']
  created_at timestamp
  updated_at timestamp

  indexes {
    admin_id
    (status, scheduled_at)
  }
}

Table broadcast_logs {
  broadcast_log_id bigint [pk, increment]
  campaign_id bigint [not null]
  user_id bigint [not null]
  phone_number varchar(32) [not null]
  message_content text [not null]
  provider_message_id varchar(255)
  delivery_status delivery_status [not null, default: 'queued']
  provider_response text
  sent_at timestamp
  delivered_at timestamp
  read_at timestamp
  failed_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (campaign_id, user_id) [unique]
    (campaign_id, delivery_status)
    user_id
    provider_message_id
  }
}

//////////////////////////////////////////////////////
// RELATIONSHIPS
//////////////////////////////////////////////////////

Ref: users.id < role_user.user_id [delete: cascade]
Ref: roles.id < role_user.role_id [delete: cascade]

Ref: users.id < subscriptions.user_id [delete: restrict]
Ref: plans.plan_id < subscriptions.plan_id [delete: restrict]
Ref: plans.plan_id < plan_offers.plan_id [delete: restrict]
Ref: users.id < subscription_upgrade_requests.user_id [delete: restrict]
Ref: plan_offers.offer_id < subscription_upgrade_requests.offer_id [delete: restrict]
Ref: plans.plan_id < subscription_upgrade_requests.plan_id [delete: restrict]
Ref: users.id < subscription_upgrade_requests.reviewed_by [delete: restrict]
Ref: subscriptions.subscription_id < subscription_upgrade_requests.approved_subscription_id [delete: restrict]

Ref: users.id < materials.user_id
Ref: materials.material_id < material_topics.material_id [delete: cascade]

Ref: users.id < prompt_versions.created_by
Ref: users.id < ai_generations.user_id
Ref: materials.material_id < ai_generations.material_id
Ref: material_topics.topic_id < ai_generations.topic_id
Ref: prompt_versions.prompt_version_id < ai_generations.prompt_version_id
Ref: ai_generations.generation_id < ai_generations.parent_generation_id

Ref: users.id < ai_usage_logs.user_id
Ref: plans.plan_id < ai_usage_logs.plan_id
Ref: subscriptions.subscription_id < ai_usage_logs.subscription_id
Ref: ai_generations.generation_id < ai_usage_logs.generation_id

Ref: users.id < question_sets.user_id
Ref: ai_generations.generation_id - question_sets.generation_id
Ref: users.id < question_sets.reviewed_by
Ref: question_sets.question_set_id < questions.question_set_id [delete: cascade]
Ref: questions.question_id < question_options.question_id [delete: cascade]

Ref: users.id - whatsapp_contacts.user_id [delete: cascade]
Ref: users.id < broadcast_campaigns.admin_id
Ref: broadcast_campaigns.campaign_id < broadcast_logs.campaign_id [delete: cascade]
Ref: users.id < broadcast_logs.user_id
